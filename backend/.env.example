# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="Conversational SIEM Assistant"
DEBUG=false

# ── Security ───────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://siem_user:siem_password@localhost:5432/siem_db

# ── SIEM Mode ──────────────────────────────────────────────────────────────────
# Options: mock | elasticsearch | wazuh
# Start with "mock" during development, switch to "elasticsearch" when ready
SIEM_MODE=mock
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=siem-logs
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Options: mock | gemini | openai | anthropic
# Use "mock" if you don't have an API key yet
LLM_PROVIDER=mock

# Gemini (Google AI)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# OpenAI (uncomment if using OpenAI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Anthropic (uncomment if using Anthropic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_MODEL=claude-3-haiku-20240307

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
